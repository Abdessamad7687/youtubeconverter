CONVERTER_API_URL=http://localhost:8788/
CONVERTER_API_KEY=replace-with-the-same-backend-secret
PORT=8788
HOST=127.0.0.1
PUBLIC_BASE_URL=http://localhost:8788
ALLOWED_ORIGIN=http://localhost:3000

# Optional YouTube anti-bot configuration. Keep credentials server-side only.
# YTDLP_PROXY=http://username:password@proxy.example:8080
# Comma-separated pool. Rotation covers connection failures and media-CDN
# 403/429 responses; authentication challenges still fail closed.
# YTDLP_PROXIES=http://user:pass@proxy-a:8080,http://user:pass@proxy-b:8080
# YTDLP_PROXY_COOLDOWN_SECONDS=300
# Only matching platforms use the pool. Other extractors stay on the server's
# direct connection so a YouTube-specific pool cannot break them.
# YTDLP_PROXY_HOSTS=youtube.com,youtu.be

# Automatic YouTube Proof-of-Origin token provider. Install its yt-dlp plugin
# and keep the provider on a private/local address.
# YTDLP_PLUGIN_DIRS=/opt/totube/yt-dlp-plugins
# YTDLP_PO_TOKEN_PROVIDER_URL=http://127.0.0.1:4416
# YTDLP_YOUTUBE_PLAYER_CLIENT=mweb
# YTDLP_FFMPEG_LOCATION=/opt/totube/bin
# YTDLP_COOKIES_FILE=/etc/totube/youtube-cookies.txt
# YTDLP_JS_RUNTIME=node
# YTDLP_EXTRACTOR_ARGS=youtube:player_client=default,-tv_simply

# Public Threads posts are resolved by the Apache-2.0 threads-cli helper.
# THREADS_BIN=/opt/totube/bin/th

# Upload fallback for authorized media files (250 MB by default).
# MAX_UPLOAD_BYTES=262144000
