CONVERTER_API_URL=http://localhost:8788/
CONVERTER_API_KEY=replace-with-the-same-backend-secret
PORT=8788
PUBLIC_BASE_URL=http://localhost:8788
ALLOWED_ORIGIN=http://localhost:3000

# Optional YouTube anti-bot configuration. Keep credentials server-side only.
# YTDLP_PROXY=http://username:password@proxy.example:8080
# Comma-separated pool. Rotation happens only for connection/proxy failures;
# authentication challenges are returned immediately and never retried.
# YTDLP_PROXIES=http://user:pass@proxy-a:8080,http://user:pass@proxy-b:8080
# YTDLP_PROXY_COOLDOWN_SECONDS=300
# YTDLP_COOKIES_FILE=/etc/totube/youtube-cookies.txt
# YTDLP_JS_RUNTIME=node
# YTDLP_EXTRACTOR_ARGS=youtube:player_client=default,-tv_simply

# Upload fallback for authorized media files (250 MB by default).
# MAX_UPLOAD_BYTES=262144000
