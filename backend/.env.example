CONVERTER_API_KEY=replace-with-a-long-random-secret
PUBLIC_BASE_URL=https://converter.example.com
ALLOWED_ORIGIN=https://totube.example.com
MAX_DURATION_SECONDS=1200
MAX_FILESIZE=500M
FILE_TTL_MINUTES=30
MAX_CONCURRENT_JOBS=2
RATE_LIMIT_PER_HOUR=12
FFMPEG_BIN=ffmpeg
FFPROBE_BIN=ffprobe

# A platform-specific network pool keeps YouTube egress isolated from other
# extractors. Leave this empty when no compatible pool is available.
YTDLP_PROXIES=
YTDLP_PROXY_HOSTS=youtube.com,youtu.be
YTDLP_PROXY_COOLDOWN_SECONDS=300

# Install bgutil-ytdlp-pot-provider in this directory and run its HTTP provider
# on a private address. Never expose port 4416 publicly.
YTDLP_PLUGIN_DIRS=/opt/totube/yt-dlp-plugins
YTDLP_PO_TOKEN_PROVIDER_URL=http://127.0.0.1:4416
YTDLP_YOUTUBE_PLAYER_CLIENT=web_embedded,mweb
YTDLP_FFMPEG_LOCATION=/opt/totube/bin
